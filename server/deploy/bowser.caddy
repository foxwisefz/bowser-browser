# Import from the existing Caddyfile at top level, outside its global block.
bowser.app {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 16384
	}
	reverse_proxy bowser:8080 {
		# Caddy resolves client_ip using the global trusted proxy configuration.
		header_up X-Real-IP {client_ip}
		health_uri /healthz
		health_interval 15s
		health_timeout 3s
	}
}
