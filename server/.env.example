# Start from repo root. Set real persistent paths before deployment.
HOST=127.0.0.1
PORT=8080
BOWSER_DATABASE=/var/lib/bowser-server/bowser.sqlite
BOWSER_TRUSTED_PROXY=127.0.0.1
# Empty until an effective Terms version is ready.
BOWSER_TERMS_VERSIONS=
BOWSER_TELEMETRY_ENABLED=0
# Required when telemetry is enabled; choose an actual policy, 1..365 days.
BOWSER_EVENT_RETENTION_DAYS=
# Optional approved release ZIP, matching the landing-page download links.
BOWSER_DOWNLOAD_PATH=
# Optional direct TLS instead of Caddy. Both must be set together.
BOWSER_TLS_CERT=
BOWSER_TLS_KEY=
