# Import at top level, outside the global Caddy options block.
bowser.app {
    redir https://www.bowser.app{uri} permanent
}

www.bowser.app {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    @service path /v1 /v1/* /updates /updates/* /healthz /Bowser.dmg
    handle @service {
        respond 404
    }
    handle {
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Real-IP {remote_host}
            health_uri /healthz
            health_interval 15s
            health_timeout 3s
        }
    }
}

api.bowser.app {
    header Strict-Transport-Security "max-age=31536000"
    request_body {
        max_size 16384
    }
    @service path /v1/registrations /v1/events /healthz
    handle @service {
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Real-IP {remote_host}
            health_uri /healthz
            health_interval 15s
            health_timeout 3s
        }
    }
    handle {
        respond 404
    }
}
