#!/usr/bin/env python3
"""Activate staged builds only after all Bowser processes exit; never kill one."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import time
import socket
import struct
import uuid
import re


def busy(manifest, processes=None):
    # The relay itself is Python, so ps comm cannot identify it by runtime path.
    owner = Path(manifest.get('home', Path(manifest['runtime']).parent)) / 'backend/owner.lock'
    if owner.exists():
        with open(owner, 'r') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
    if processes is None:
        processes = subprocess.check_output(['/bin/ps', '-axo', 'comm='], text=True)
    roots = [manifest['bundle'] + '/', manifest['runtime'] + '/',
             str(Path.home() / 'Applications/Bowser Apps') + '/',
             str(Path(manifest.get('home', Path(manifest['runtime']).parent)) / 'releases') + '/']
    return any(any(line.strip().startswith(root) for root in roots)
               for line in processes.splitlines())


def activate(manifest):
    """Keep the previous pair, and roll back both destinations on failure."""
    changed = []
    try:
        for key in ('runtime', 'bundle'):
            source = Path(manifest['stage']) / key
            if not source.exists():
                continue
            target = Path(manifest[key])
            previous = target.with_name(target.name + '.previous')
            if previous.exists():
                shutil.rmtree(previous)
            existed = target.exists()
            if existed:
                target.rename(previous)
            changed.append((target, previous, existed, source))
            source.rename(target)
    except Exception:
        for target, previous, existed, source in reversed(changed):
            if target.exists():
                target.rename(source)
            if existed and previous.exists():
                previous.rename(target)
        raise


def publish(path, manifest, shell_only=False, brain_only=False):
    """Merge partial builds into the pending generation under the activation lock."""
    path = Path(path)
    with open(path.with_suffix('.lock'), 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        previous = json.loads(path.read_text()) if path.exists() else None
        if previous:
            if any(previous[key] != manifest[key] for key in ('runtime', 'bundle')):
                raise ValueError('Pending update targets differ; use a separate BOWSER_HOME.')
            old = Path(previous['stage'])
            new = Path(manifest['stage'])
            if shell_only and (old / 'runtime/brain').exists():
                shutil.rmtree(new / 'runtime/brain', ignore_errors=True)
                shutil.copytree(old / 'runtime/brain', new / 'runtime/brain')
            if brain_only and (old / 'bundle').exists():
                shutil.copytree(old / 'bundle', new / 'bundle')
        temporary = path.with_suffix('.new')
        temporary.write_text(json.dumps(manifest))
        os.replace(temporary, path)
        if previous and previous['stage'] != manifest['stage']:
            shutil.rmtree(previous['stage'], ignore_errors=True)


def live_update(manifest):
    """Ask the existing relay to adopt an immutable copy; legacy hosts defer."""
    home = Path(manifest.get('home', Path(manifest['runtime']).parent))
    endpoint = home / 'backend/host.sock'
    stage = Path(manifest['stage']) / 'runtime'
    if not endpoint.exists() or not (stage / 'HANDOFF.json').exists():
        return False
    if manifest.get('live_runtime'):
        runtime = Path(manifest['live_runtime'])
    else:
        releases = home / 'releases'
        releases.mkdir(mode=0o700, parents=True, exist_ok=True)
        runtime = releases / uuid.uuid4().hex
        temporary = runtime.with_suffix('.new')
        shutil.copytree(stage, temporary)
        temporary.rename(runtime)
        manifest['live_runtime'] = str(runtime)
    message = json.dumps(dict(op='update', runtime=str(runtime))).encode()
    try:
        with socket.socket(socket.AF_UNIX) as peer:
            peer.settimeout(30)
            peer.connect(str(endpoint))
            peer.sendall(struct.pack('>I', len(message)) + message)
            def read(n):
                data = b''
                while len(data) < n:
                    part = peer.recv(n - len(data))
                    if not part:
                        raise ConnectionError('backend host disconnected')
                    data += part
                return data
            size, = struct.unpack('>I', read(4))
            if size > 65536:
                raise ValueError('oversized update response')
            reply = json.loads(read(size))
        if reply.get('ok'):
            manifest['backend_applied'] = True
            print('Backend updated live; existing pages remain alive.', flush=True)
            return True
        manifest['deferred_reason'] = reply.get('error', 'backend deferred')
    except (OSError, ValueError) as error:
        manifest['deferred_reason'] = str(error)
    print('Live update deferred: ' + manifest['deferred_reason'], flush=True)
    return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('pending', type=Path)
    parser.add_argument('--wait', action='store_true')
    args = parser.parse_args()
    args.pending.parent.mkdir(parents=True, exist_ok=True)
    with open(args.pending.with_suffix('.watcher.lock'), 'w') as watcher:
        try:
            fcntl.flock(watcher, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        while True:
            with open(args.pending.with_suffix('.lock'), 'w') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                if not args.pending.exists():
                    return
                manifest = json.loads(args.pending.read_text())
                if busy(manifest) and not manifest.get('backend_applied'):
                    # Retry only once per minute, not a constant freeze loop.
                    if time.time() - manifest.get('live_attempt_at', 0) >= 60:
                        manifest['live_attempt_at'] = time.time()
                        live_update(manifest)
                        temporary = args.pending.with_suffix('.new')
                        temporary.write_text(json.dumps(manifest))
                        os.replace(temporary, args.pending)
                if not busy(manifest):
                    time.sleep(2)
                    if not busy(manifest):
                        activate(manifest)
                        home = Path(manifest.get('home', Path(manifest['runtime']).parent))
                        (home / 'backend/active.json').unlink(missing_ok=True)
                        # These are installer-owned immutable copies. At this
                        # boundary no native/relay/BEAM process is using them.
                        for release in (home / 'releases').glob('*'):
                            if re.fullmatch(r'[0-9a-f]{32}', release.name) and release.is_dir() and not release.is_symlink():
                                shutil.rmtree(release)
                        args.pending.unlink()
                        shutil.rmtree(manifest['stage'], ignore_errors=True)
                        print('Staged Bowser update activated. Ready for next launch.', flush=True)
                        return
            if not args.wait:
                print('Update staged; it will activate after Bowser and saved apps quit.', flush=True)
                return
            time.sleep(2)


if __name__ == '__main__':
    main()
