#!/bin/bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd -P)"
fixture="$(mktemp -d /tmp/bowser-resource-check.XXXXXX)"
cp -f "$repo/experiments/native-modules/fixture.html" "$fixture/fixture.html"
ffmpeg -hide_banner -loglevel error -f lavfi -i 'testsrc2=size=320x180:rate=30' -t 45 -c:v libx264 -pix_fmt yuv420p "$fixture/video.mp4"
python3 "$repo/tests/native-resources/download_server.py" "$fixture" &
server_pid=$!
trap 'kill "$server_pid" 2>/dev/null || true; wait "$server_pid" 2>/dev/null || true' EXIT
for attempt in {1..100}; do [ -f "$fixture/download-url" ] && break; sleep 0.05; done
export BOWSER_DOWNLOAD_URL="$(cat "$fixture/download-url")"
BOWSER_RESOURCE_FIXTURE="$fixture/fixture.html" BOWSER_TEST_ROOT="$repo" swift test --package-path "$repo/shell" --filter NativeControllerIntegrationTests
