#!/bin/bash
# Build an immutable, uniquely named Swift module with a sealed admission record.
set -euo pipefail
[ "$#" = 1 ] || { echo 'usage: bin/build-native-surfaces OUTPUT.bundle' >&2; exit 2; }
repo="$(cd "$(dirname "$0")/.." && pwd -P)"
output="$1"
[ ! -e "$output" ] || { echo 'module output already exists' >&2; exit 1; }
identity="${BOWSER_SIGN_IDENTITY:--}"
configuration="${BOWSER_NATIVE_CONFIGURATION:-debug}"
(cd "$repo/shell" && swift build -c "$configuration" --product BowserSurfaceKit)
kit="$repo/shell/.build/$configuration"
kit_id="$(dwarfdump --uuid "$kit/libBowserSurfaceKit.dylib" | awk '{print $2}' | tr -d '-' | tr '[:upper:]' '[:lower:]')"
[[ "$kit_id" =~ ^[0-9a-f]{32}$ ]] || { echo 'invalid surface state library identity' >&2; exit 1; }
build="$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]')"
mkdir -p "$output/Contents/MacOS"
swiftc -target arm64-apple-macos15.0 -swift-version 6 -O -parse-as-library -emit-library -module-name "BowserSurfaces_$build" \
  -Xlinker -rpath -Xlinker /usr/lib/swift \
  -I "$kit/Modules" -L "$kit" -lBowserSurfaceKit \
  "$repo/shell/Sources/Bowser/NativeUIRenderer.swift" \
  "$repo/shell/Sources/Bowser/CommandPaletteRenderer.swift" \
  "$repo/shell/Sources/Bowser/BrowserScreens.swift" \
  "$repo/shell/Sources/Bowser/SurfaceRenderer.swift" \
  "$repo/shell/Sources/Bowser/SurfaceTabDrag.swift" \
  "$repo/shell/Sources/Bowser/TabDustEffect.swift" \
  "$repo/shell/Sources/Bowser/SurfaceForms.swift" \
  "$repo/shell/Sources/Bowser/SurfaceComposition.swift" \
  "$repo/shell/Sources/Bowser/SurfaceNativeEditor.swift" \
  "$repo/shell/Sources/Bowser/SurfaceTextEditor.swift" \
  "$repo/shell/NativeModules/Surfaces/Exports.swift" -o "$output/Contents/MacOS/SurfaceRenderer"
cat > "$output/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.foxwiseai.bowser.surfaces</string>
<key>CFBundleExecutable</key><string>SurfaceRenderer</string>
<key>CFBundlePackageType</key><string>BNDL</string>
<key>CFBundleVersion</key><string>$build</string>
<key>BowserSurfaceKit</key><string>$kit_id</string>
<key>BowserHostABI</key><integer>1</integer>
<key>BowserStateSchema</key><integer>1</integer>
<key>BowserBackendProtocol</key><integer>1</integer>
</dict></plist>
PLIST
args=(--force --sign "$identity")
if [ "$identity" != - ]; then args+=(--options runtime); fi
if [ -n "${BOWSER_SIGN_KEYCHAIN:-}" ]; then args+=(--keychain "$BOWSER_SIGN_KEYCHAIN"); fi
codesign "${args[@]}" "$output"
codesign --verify --strict "$output"
echo "Built surface renderer $build"
