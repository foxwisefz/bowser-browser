#!/bin/sh
# Spawn shim for the browser: ties the child's life to the BEAM's, and the
# wrapper's life to the child's.
# - BEAM dies (any way): the port pipe (our stdin) closes -> watcher kills child.
# - Child dies (crash/pkill): main wait returns -> wrapper exits with the
#   child's status so the supervisor sees it and respawns.
# NB: backgrounded commands get stdin from /dev/null in sh, so the watcher
# must be handed the real stdin explicitly via fd 3.
"$@" &
child=$!
trap 'kill -TERM "$child" 2>/dev/null' TERM INT

exec 3<&0
( cat 0<&3 > /dev/null; kill -TERM "$child" 2>/dev/null ) &
watcher=$!

wait "$child"
status=$?
kill "$watcher" 2>/dev/null
exit "$status"
