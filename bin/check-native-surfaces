#!/bin/bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd -P)"
: "${BOWSER_SIGN_IDENTITY:?Set Developer ID identity to qualify signed module replacement}"
root="$(mktemp -d /tmp/bowser-surfaces-check.XXXXXX)"
app="$root/SurfaceCheck.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$app/Contents/Frameworks"
configuration="${BOWSER_NATIVE_CONFIGURATION:-debug}"
(cd "$repo/shell" && swift build -c "$configuration" --product BowserSurfaceKit)
kit="$repo/shell/.build/$configuration"
cp -f "$kit/libBowserSurfaceKit.dylib" "$app/Contents/Frameworks/"
codesign --force --options runtime --sign "$BOWSER_SIGN_IDENTITY" "$app/Contents/Frameworks/libBowserSurfaceKit.dylib"
"$repo/bin/build-native-surfaces" "$app/Contents/Resources/SurfaceRenderer.bundle"
"$repo/bin/build-native-surfaces" "$root/Second.bundle"
cp -f "$repo/experiments/native-modules/fixture.html" "$root/fixture.html"
ffmpeg -hide_banner -loglevel error -f lavfi -i 'testsrc2=size=320x180:rate=30' -t 45 -c:v libx264 -pix_fmt yuv420p "$root/video.mp4"
swiftc -O -swift-version 6 -I "$kit/Modules" -L "$kit" -lBowserSurfaceKit -Xlinker -rpath -Xlinker @executable_path/../Frameworks "$repo/shell/Sources/Bowser/NativeModules.swift" "$repo/shell/Sources/Bowser/BowserPaths.swift" "$repo/shell/Sources/Bowser/SurfaceRenderer.swift" "$repo/shell/Sources/Bowser/SurfaceTabDrag.swift" "$repo/shell/Sources/Bowser/TabDustEffect.swift" "$repo/shell/Sources/Bowser/SurfaceForms.swift" "$repo/shell/Sources/Bowser/SurfaceComposition.swift" "$repo/shell/Sources/Bowser/SurfaceNativeEditor.swift" "$repo/shell/Sources/Bowser/SurfaceTextEditor.swift" "$repo/shell/Sources/Bowser/LiveSurface.swift" "$repo/tests/native-surfaces/main.swift" -o "$app/Contents/MacOS/SurfaceCheck"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.foxwiseai.bowser.surfaces-check</string>
<key>CFBundleExecutable</key><string>SurfaceCheck</string>
<key>ProbeRoot</key><string>$root</string>
</dict></plist>
PLIST
codesign --force --options runtime --sign "$BOWSER_SIGN_IDENTITY" "$app"
codesign --verify --deep --strict "$app"
codesign -dvv "$app" 2> "$root/signing.txt"
grep -q 'runtime' "$root/signing.txt"
codesign -d --entitlements - "$app" > "$root/entitlements.txt" 2>/dev/null
if grep -q 'disable-library-validation' "$root/entitlements.txt"; then echo 'library validation disabled' >&2; exit 1; fi
open -n -W "$app"
if [ -f "$root/failure" ]; then cat "$root/failure"; echo "Artifacts: $root"; exit 1; fi
cat "$root/result.json"
echo "Artifacts: $root"
