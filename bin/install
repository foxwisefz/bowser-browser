#!/usr/bin/env bash
# Build Bowser and stage updates until the installed apps have quit. The
# brain release and helpers remain under ~/.bowser/app.
# The working copy is never executed by the installed brain: it runs its own
# release and spawns the installed Bowser.app, so builds and edits here do not
# replace the browser while you are using it.
#
#   bin/install                 stage shell + brain; activate only when apps are stopped
#   bin/install --shell-only    stage only the browser and helpers
#   bin/install --brain-only    stage only the brain and helpers
#   bin/install --release       release shell build (DEFAULT IS DEBUG until the
#                               release-only SIGTRAP in BrainBridge's listener is fixed —
#                               see bead bowser-browser-oeo; debug in a bundle runs fine)
#   bin/install --debug         explicit debug shell build (the current default)
#   bin/install --no-restart    compatibility alias; installs never restart apps
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd -P)"
APP_DIR="${BOWSER_APP_DIR:-$HOME/.bowser/app}"
BUNDLE="${BOWSER_BUNDLE_PATH:-$HOME/Applications/Bowser.app}"
SHELL_ONLY=0; BRAIN_ONLY=0; DEBUG=1
for a in "$@"; do case "$a" in
  --shell-only) SHELL_ONLY=1;; --brain-only) BRAIN_ONLY=1;; --debug) DEBUG=1;; --release) DEBUG=0;; --no-restart) :;;
  *) echo "unknown flag: $a" >&2; exit 2;;
esac; done

VERSION="$(cd "$REPO" && (jj log -r @ --no-graph -T 'change_id.short()' 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo dev))"
BUILD="$(date +%Y%m%d%H%M%S)"
say() { printf '\033[1m▸ %s\033[0m\n' "$*"; }

say "checking icon crash isolation before replacing the installed app"
"$REPO/bin/check-icon-isolation"

# Native helpers are required even for brain-only builds. Customers never need Python.
say "runtime: compiling native helpers"
(cd "$REPO/shell" && swift build --product BowserBackendHost && swift build --product BowserRuntimeTool)
RUNTIME_TOOL="$REPO/shell/.build/debug/BowserRuntimeTool"
BACKEND_HOST="$REPO/shell/.build/debug/BowserBackendHost"

# Never replace a running bundle/runtime: older brains still watch mtime.
DEST_APP_DIR="$APP_DIR"
DEST_BUNDLE="$BUNDLE"
UPDATE_ROOT="${BOWSER_HOME:-$HOME/.bowser}/updates"
mkdir -p "$UPDATE_ROOT" "$(dirname "$BUNDLE")"
BUILD_STAGE="$(mktemp -d "$UPDATE_ROOT/build.XXXXXX")"
APP_DIR="$BUILD_STAGE/runtime"
BUNDLE="$BUILD_STAGE/bundle"
# Partial updates start from the installed runtime, preserving its release.
BASE_RUNTIME="$DEST_APP_DIR"
ACTIVE_RUNTIME="${BOWSER_HOME:-$HOME/.bowser}/backend/active.json"
if [ -f "$ACTIVE_RUNTIME" ]; then
  BASE_RUNTIME="$("$RUNTIME_TOOL" active-runtime "$ACTIVE_RUNTIME")"
fi
if [ -d "$BASE_RUNTIME" ]; then cp -R "$BASE_RUNTIME" "$APP_DIR"; fi
mkdir -p "$APP_DIR/bin"
# Remove only obsolete helper artifacts from the unpublished copy.
rm -rf "$APP_DIR/bin/__pycache__"
rm -f "$APP_DIR/bin/backend-host.before-loop-fix" "$APP_DIR/bin/install"

# ---------------------------------------------------------------- shell
if [ "$BRAIN_ONLY" = 0 ]; then
  CONF=release; [ "$DEBUG" = 1 ] && CONF=debug
  say "shell: swift build -c $CONF"
  (cd "$REPO/shell" && swift build -c "$CONF")
  BIN="$REPO/shell/.build/$CONF/Bowser"
  [ -x "$BIN" ] || { echo "no binary at $BIN — build failed" >&2; exit 1; }
  # Never trust "Build complete": the artifact must be newer than the sources.
  NEWEST_SRC="$(find "$REPO/shell/Sources/Bowser" -name '*.swift' -newer "$BIN" | head -1)"
  [ -z "$NEWEST_SRC" ] || { echo "binary older than $NEWEST_SRC — stale build" >&2; exit 1; }

  say "shell: assembling $BUNDLE ($VERSION)"
  STAGE="$(mktemp -d)"; mkdir -p "$STAGE/Bowser.app/Contents/MacOS" "$STAGE/Bowser.app/Contents/Resources"
  cp "$BIN" "$STAGE/Bowser.app/Contents/MacOS/Bowser"
  cp "$REPO/assets/AppIcon.icns" "$STAGE/Bowser.app/Contents/Resources/AppIcon.icns"
  cp -Rf "$REPO/shell/Sources/Bowser/Resources/ProfileCharacters" "$STAGE/Bowser.app/Contents/Resources/ProfileCharacters"
  sed -e "s/__VERSION__/$VERSION/" -e "s/__BUILD__/$BUILD/" "$REPO/bin/Info.plist" > "$STAGE/Bowser.app/Contents/Info.plist"
  printf 'APPL????' > "$STAGE/Bowser.app/Contents/PkgInfo"
  codesign --force --deep --sign - "$STAGE/Bowser.app" >/dev/null 2>&1 || echo "  (codesign skipped)"
  # Assemble inside the unpublished generation.
  rm -rf "$BUNDLE.new"; mv "$STAGE/Bowser.app" "$BUNDLE.new"; rm -rf "$BUNDLE.old"
  [ -d "$BUNDLE" ] && mv "$BUNDLE" "$BUNDLE.old"; mv "$BUNDLE.new" "$BUNDLE"; rm -rf "$BUNDLE.old" "$STAGE"
fi

# ---------------------------------------------------------------- helpers
say "bin: engine-wrapper, mcp bridge, bowser"
cp -f "$REPO/bin/engine-wrapper" "$REPO/bin/bowser" "$APP_DIR/bin/"
cp -f "$BACKEND_HOST" "$APP_DIR/bin/backend-host"
for helper in detach apply-update bowser-mcp-bridge; do
  cp -f "$RUNTIME_TOOL" "$APP_DIR/bin/$helper"
  codesign --force --sign - "$APP_DIR/bin/$helper"
done
codesign --force --sign - "$APP_DIR/bin/backend-host"
WORKER="$REPO/shell/.build/${CONF:-debug}/BowserIconWorker"
[ -x "$WORKER" ] || { echo "missing icon worker: $WORKER" >&2; exit 1; }
cp -f "$WORKER" "$APP_DIR/bin/BowserIconWorker.new"
codesign --force --sign - "$APP_DIR/bin/BowserIconWorker.new"
mv -f "$APP_DIR/bin/BowserIconWorker.new" "$APP_DIR/bin/BowserIconWorker"
chmod +x "$APP_DIR/bin/"*

# ---------------------------------------------------------------- brain
if [ "$SHELL_ONLY" = 0 ]; then
  say "brain: mix release (prod)"
  (cd "$REPO/beam" && MIX_ENV=prod mix release bowser_brain --overwrite --quiet)
  REL="$REPO/beam/_build/prod/rel/bowser_brain"
  [ -x "$REL/bin/bowser_brain" ] || { echo "no release at $REL" >&2; exit 1; }
  rm -rf "$APP_DIR/brain.new"; cp -R "$REL" "$APP_DIR/brain.new"
  rm -rf "$APP_DIR/brain.old"; [ -d "$APP_DIR/brain" ] && mv "$APP_DIR/brain" "$APP_DIR/brain.old"
  mv "$APP_DIR/brain.new" "$APP_DIR/brain"; rm -rf "$APP_DIR/brain.old"
fi

if [ "$SHELL_ONLY" = 0 ]; then
  printf '{"protocol":1,"state_schema":3}\n' > "$APP_DIR/HANDOFF.json"
fi
echo "$VERSION $BUILD" > "$APP_DIR/VERSION"
say "built $VERSION → $BUILD_STAGE"

# Publish a complete generation only after builds and signatures succeed.
# Atomic replacement: an existing watcher can keep executing its mapped binary.
cp -f "$RUNTIME_TOOL" "$UPDATE_ROOT/apply-update.new"
codesign --force --sign - "$UPDATE_ROOT/apply-update.new"
mv -f "$UPDATE_ROOT/apply-update.new" "$UPDATE_ROOT/apply-update"
"$RUNTIME_TOOL" publish "$UPDATE_ROOT/pending.json" "$BUILD_STAGE" "$DEST_APP_DIR" "$DEST_BUNDLE" "$SHELL_ONLY" "$BRAIN_ONLY"
# A dormant login job resumes pending activation even if this session reboots.
# It runs only while a manifest exists and exits immediately after activation.
AGENT_DIR="$HOME/Library/LaunchAgents"
AGENT_LABEL="com.gezim.bowser.pending-update"
mkdir -p "$AGENT_DIR"
"$RUNTIME_TOOL" watcher-plist "$AGENT_DIR/$AGENT_LABEL.plist" "$UPDATE_ROOT"
"$UPDATE_ROOT/apply-update" "$UPDATE_ROOT/pending.json" --refresh-watcher
# The updater binary was replaced above. Refresh its launchd registration too:
# retaining the old registration can retain a stale code requirement on Tahoe
# ("Unable to get updated LWCR", EX_CONFIG), so kickstart never runs the job.
if launchctl print "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1; then
  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" || {
    echo "Unable to refresh pending-update login job; update remains staged." >&2; exit 1;
  }
fi
launchctl bootstrap "gui/$(id -u)" "$AGENT_DIR/$AGENT_LABEL.plist" || {
  echo "Unable to register pending-update login job; update remains staged." >&2; exit 1;
}

launchctl kickstart "gui/$(id -u)/$AGENT_LABEL"
"$UPDATE_ROOT/apply-update" "$UPDATE_ROOT/pending.json"
if [ -f "$UPDATE_ROOT/pending.json" ]; then
  say "native update staged — compatible backend updates apply live; native changes activate after apps quit"
else
  say "installed — ready for next launch"
fi
