#!/bin/bash
# Submit an app archive or DMG, require acceptance, and staple its ticket.
set -euo pipefail
[ "$#" -eq 2 ] || { echo 'usage: bin/notarize ARCHIVE STAPLE_TARGET' >&2; exit 2; }
: "${BOWSER_NOTARY_PROFILE:?Set a notarytool keychain profile}"
auth=(--keychain-profile "$BOWSER_NOTARY_PROFILE")
if [ -n "${BOWSER_SIGN_KEYCHAIN:-}" ]; then auth+=(--keychain "$BOWSER_SIGN_KEYCHAIN"); fi
result="$(mktemp /tmp/bowser-notary.XXXXXX)"
trap 'rm -f "$result"' EXIT
if ! xcrun notarytool submit "$1" "${auth[@]}" --wait --timeout 25m --output-format json > "$result"; then
  cat "$result" >&2
  exit 1
fi
# notarytool can finish processing a rejected submission successfully: require
# Accepted explicitly before stapling or permitting update metadata to be signed.
python3 - "$result" <<'PY'
import json, sys
result = json.load(open(sys.argv[1]))
if result.get('status') != 'Accepted':
    raise SystemExit('Notarization not accepted: ' + str(result.get('status')) + '; submission ' + str(result.get('id')))
print('Apple accepted submission ' + str(result.get('id')))
PY
xcrun stapler staple "$2"
xcrun stapler validate "$2"
