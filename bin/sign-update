#!/usr/bin/env swift
// Release-operator tool. Private keys stay on the signing machine.
import Foundation
import CryptoKit

func fail(_ message: String) -> Never { fputs(message + "\n", stderr); exit(1) }
let args = Array(CommandLine.arguments.dropFirst())
do {
    if args.count == 2 && args[0] == "--public-key" {
        let key = try Curve25519.Signing.PrivateKey(rawRepresentation: Data(contentsOf: URL(fileURLWithPath: args[1])))
        print(key.publicKey.rawRepresentation.base64EncodedString())
        exit(0)
    }
    if args.count == 2 && args[0] == "--generate-key" {
        let file = URL(fileURLWithPath: args[1])
        guard !FileManager.default.fileExists(atPath: file.path) else { fail("Refusing to overwrite a signing key") }
        let key = Curve25519.Signing.PrivateKey()
        try key.rawRepresentation.write(to: file, options: .withoutOverwriting)
        try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: file.path)
        print("BOWSER_UPDATE_PUBLIC_KEY=" + key.publicKey.rawRepresentation.base64EncodedString())
        exit(0)
    }
    guard args.count == 6 else { fail("usage: sign-update KEY DMG VERSION BUILD MIN_MACOS OUTPUT.json | --generate-key PATH | --public-key PATH") }
    let key = try Curve25519.Signing.PrivateKey(rawRepresentation: Data(contentsOf: URL(fileURLWithPath: args[0])))
    let image = URL(fileURLWithPath: args[1])
    guard UInt64(args[3]) != nil, let os = Int(args[4]), os >= 15 else { fail("Invalid build or minimum macOS") }
    let file = try FileHandle(forReadingFrom: image); defer { try? file.close() }
    var hash = SHA256()
    while let chunk = try file.read(upToCount: 1_048_576), !chunk.isEmpty { hash.update(data: chunk) }
    let bytes = try image.resourceValues(forKeys: [.fileSizeKey]).fileSize!
    guard bytes > 0 && bytes <= 1_073_741_824 else { fail("Image must be between 1 byte and 1 GiB") }
    let payload = try JSONSerialization.data(withJSONObject: [
        "version": args[2], "build": args[3], "minimumMacOS": os,
        "url": "https://bowser.app/updates/Bowser.dmg", "bytes": bytes,
        "sha256": hash.finalize().map { String(format: "%02x", $0) }.joined(),
        "expiresAt": ISO8601DateFormatter().string(from: Date().addingTimeInterval(30 * 86400))
    ], options: [.sortedKeys])
    let signature = try key.signature(for: payload)
    let envelope = try JSONSerialization.data(withJSONObject: ["payload": payload.base64EncodedString(), "signature": signature.base64EncodedString()], options: [.sortedKeys])
    try envelope.write(to: URL(fileURLWithPath: args[5]), options: .atomic)
    print("Signed update manifest. Publish with the matching DMG; expires in 30 days.")
} catch { fail("Signing failed: \(error)") }
