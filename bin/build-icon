#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd -P)"
ARTWORK="$REPO/assets/BowserArtwork.jpg"
OUTPUT="$REPO/assets/AppIcon.icns"
TMP="$(mktemp -d)"
ICON="$TMP/AppIcon.png"
ICONSET="$TMP/AppIcon.iconset"
trap 'rm -rf "$TMP"' EXIT

command -v iconutil >/dev/null || { echo "iconutil is required" >&2; exit 1; }
[ -f "$ARTWORK" ] || { echo "missing $ARTWORK" >&2; exit 1; }

python3 - "$ARTWORK" "$ICON" <<'PY'
from PIL import Image
import sys

source = Image.open(sys.argv[1]).convert("RGBA")
bounds = source.getbbox()
if bounds is None:
    raise SystemExit("artwork is empty")
left, top, right, bottom = bounds
padding = 28
left = max(0, left - padding)
top = max(0, top - padding)
right = min(source.width, right + padding)
bottom = min(source.height, bottom + padding)
cropped = source.crop((left, top, right, bottom))
cropped.thumbnail((900, 900), Image.Resampling.LANCZOS)
canvas = Image.new("RGBA", (1024, 1024))
position = ((1024 - cropped.width) // 2, (1024 - cropped.height) // 2)
canvas.alpha_composite(cropped, position)
canvas.save(sys.argv[2], optimize=True)
PY

mkdir -p "$ICONSET"
render() {
  sips --resampleHeightWidth "$1" "$1" "$ICON" --out "$ICONSET/$2" >/dev/null
}
render 16 icon_16x16.png
render 32 icon_16x16@2x.png
render 32 icon_32x32.png
render 64 icon_32x32@2x.png
render 128 icon_128x128.png
render 256 icon_128x128@2x.png
render 256 icon_256x256.png
render 512 icon_256x256@2x.png
render 512 icon_512x512.png
render 1024 icon_512x512@2x.png
iconutil --convert icns --output "$OUTPUT" "$ICONSET"
